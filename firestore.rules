rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "myangegamichael6@gmail.com"
      ); 
    }
    function isCommittee() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/committee_members/$(request.auth.uid)) ||
        request.auth.token.email == "myangegamichael6@gmail.com"
      );
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['student', 'landlord', 'admin', 'committee'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1048576)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 64)) &&
             (!('department' in data) || (data.department is string && data.department.size() <= 128)) &&
             (!('matricNumber' in data) || (data.matricNumber is string && data.matricNumber.size() <= 64)) &&
             (!('level' in data) || (data.level is string && data.level.size() <= 64)) &&
             (!('institution' in data) || (data.institution is string && data.institution.size() <= 256)) &&
             (!('verificationStatus' in data) || (data.verificationStatus in ['unverified', 'pending', 'verified', 'rejected'])) &&
             (!('isVerified' in data) || (data.isVerified is bool));
    }

    function isValidProperty(data) {
      return data.keys().hasAll(['ownerId', 'title', 'price', 'location']) &&
             data.ownerId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price > 0 &&
             data.location is string &&
             (!('isBooked' in data) || data.isBooked is bool);
    }

    function isValidBooking(data) {
      return data.keys().hasAll(['propertyId', 'studentId', 'landlordId', 'totalPrice']) &&
             data.studentId is string &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             (!('status' in data) || data.status in ['pending', 'paid', 'confirmed', 'cancelled']);
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'userName', 'rating', 'comment', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() >= 5 && data.comment.size() <= 1000;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (
        isOwner(userId) && 
        isValidUser(incoming()) && (
          // Action: Profile Update (Owner can change these)
          (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'phoneNumber', 'department', 'matricNumber', 'level', 'institution', 'updatedAt']) &&
           incoming().role == existing().role &&
           incoming().isVerified == existing().isVerified) ||
          // Action: Verification Submission (Owner can submit for verification)
          (incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus', 'verificationData', 'updatedAt']) &&
           incoming().verificationStatus == 'pending') ||
          // Action: No-op or minor change
          (incoming().diff(existing()).affectedKeys().size() == 0)
        )
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isValidProperty(incoming()) && incoming().status == 'pending';
      allow update: if (isOwner(existing().ownerId) && isValidProperty(incoming()) && 
                        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'price', 'images', 'amenities', 'isBooked', 'updatedAt'])) ||
                    isAdmin() || 
                    (isCommittee() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.landlordId || isAdmin());
      allow list: if isSignedIn() && (resource.data.studentId == request.auth.uid || resource.data.landlordId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidBooking(incoming());
      allow update: if isSignedIn() && (request.auth.uid == resource.data.studentId || request.auth.uid == resource.data.landlordId || isAdmin());
      allow delete: if isAdmin();
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow list: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin()) &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt']);
      
      match /messages/{messageId} {
        allow list, get: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
        allow create: if isSignedIn() && (request.auth.uid == incoming().senderId || isAdmin()) &&
                       (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin());
      }
    }
    
    match /admins/{adminId} {
      allow read: if isSignedIn();
    }

    match /calls/{callId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow list: if isSignedIn() && (resource.data.calleeId == request.auth.uid || resource.data.callerId == request.auth.uid);
      allow create: if isSignedIn() && request.auth.uid == incoming().callerId;
      allow update: if isSignedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);

      match /offerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
      match /answerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidReview(incoming());
      allow delete: if isSignedIn() && (request.auth.uid == existing().userId || isAdmin());
    }
  }
}
