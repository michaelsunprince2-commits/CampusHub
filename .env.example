# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Database.
DB_HOST="localhost"
DB_USER="root"
DB_PASS=""
DB_NAME="campusnest"
DB_PORT="3306"
ENVIRONMENT="development"

# Set to false/off/0/no to pause new property video uploads without affecting images or existing videos.
VIDEO_UPLOADS_ENABLED="true"

# OAuth credentials.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Paystack credentials.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Mail settings for password reset emails.
MAIL_FROM="no-reply@campusnest.local"
MAIL_FROM_NAME="CampusNest"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_SECURE="tls"
